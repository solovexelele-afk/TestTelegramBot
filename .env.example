# Скопируйте этот файл в .env и заполните. Файл .env НЕ попадает в Git.

# Токен от @BotFather
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# polling (локально) или webhook (хостинг). Пусто = автоопределение.
BOT_MODE=polling

LOG_LEVEL=INFO
LOG_TO_FILE=true

# --- Только для режима webhook (на хостинге) ---
# WEBHOOK_BASE_URL=https://your-app.onrender.com   (на Render берётся из RENDER_EXTERNAL_URL)
# WEBHOOK_SECRET=длинная-случайная-строка
# WEBHOOK_PATH=/webhook
# PORT=8080
